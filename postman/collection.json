                  "    pm.expect(json.data).to.have.property('id').that.is.a('number');",
                  "});",
                  "pm.test('no unexpected error keys on a success response', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.not.have.property('error');",
                  "    pm.expect(json).to.not.have.property('errors');",
                  "});"
                ]
              }
            }
          ]
        }
