{
  "name": "exclusive-resorts-inquiry-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + Postman QA suite for the Exclusive Resorts membership inquiry form",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:api": "newman run postman/collection.json -e postman/environment.json",
    "test:api-endpoints": "playwright test --grep @api",
    "test:web": "playwright test --grep-invert @api"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.7.0",
    "newman": "^6.2.1",
    "typescript": "^5.6.0"
  }
}
